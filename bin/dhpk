#!/usr/bin/env bash
set -euo pipefail

# PATH 連結會讓呼叫路徑偏離套件位置；逐層解析相對連結後再定位資源。
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  if [[ "$SOURCE" != /* ]]; then
    SOURCE="$LINK_DIR/$SOURCE"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

usage() {
  printf '%s\n' 'usage: dhpk <distribution|harness|install> [args...]'
  printf '%s\n' '       dhpk <--version|--help>'
}

case "${1:-}" in
  harness)
    shift
    exec node "$SCRIPT_DIR/../scripts/dhpk-harness.js" "$@"
    ;;
  distribution)
    shift
    exec "$SCRIPT_DIR/dhpk-distribution" "$@"
    ;;
  install)
    shift
    exec "$SCRIPT_DIR/dhpk-install" "$@"
    ;;
  --version|-v)
    node -e 'process.stdout.write(require(process.argv[1]).version + "\n")' "$SCRIPT_DIR/../package.json"
    exit 0
    ;;
  --help|-h|help|"")
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
