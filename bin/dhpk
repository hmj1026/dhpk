#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  printf '%s\n' 'usage: dhpk <distribution|harness|install> [args...]'
  printf '%s\n' '       dhpk <--version|--help>'
}

case "${1:-}" in
  harness)
    shift
    exec node "$SCRIPT_DIR/../scripts/dhpk-harness.js" "$@"
    ;;
  distribution)
    shift
    exec "$SCRIPT_DIR/dhpk-distribution" "$@"
    ;;
  install)
    shift
    exec "$SCRIPT_DIR/dhpk-install" "$@"
    ;;
  --version|-v)
    node -e 'process.stdout.write(require(process.argv[1]).version + "\n")' "$SCRIPT_DIR/../package.json"
    exit 0
    ;;
  --help|-h|help|"")
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
