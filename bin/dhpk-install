#!/usr/bin/env bash
set -euo pipefail

# PATH 連結會讓呼叫路徑偏離套件位置；逐層解析相對連結後再定位資源。
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  if [[ "$SOURCE" != /* ]]; then
    SOURCE="$LINK_DIR/$SOURCE"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec node "$SCRIPT_DIR/../scripts/dhpk-install.js" "$@"
