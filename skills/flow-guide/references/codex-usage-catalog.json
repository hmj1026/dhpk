              "apply"
            ]
          },
          {
            "id": "no-architect",
            "syntax": "--no-architect",
            "value_kind": "boolean",
            "required": false,
            "summary": "Disable the architecture pass",
            "applies_to": [
              "apply"
            ]
          },
          {
            "id": "codex",
            "syntax": "--codex",
            "value_kind": "boolean",
            "required": false,
            "summary": "Request the retired Codex diagnostic",
            "legacy": {
              "replacement_id": "worker",
              "diagnostic_only": true,
              "reason": "Use an explicit worker, worker-target, or reasoner instead of the retired Codex shortcut"
            },
