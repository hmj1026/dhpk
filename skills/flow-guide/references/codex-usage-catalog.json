  "entries": [
    {
      "id": "code-trace",
      "name": "code-trace",
      "usage": {
        "display_name": "Code Trace",
        "summary": "Trace code paths, causes, history, or navigation tools",
        "syntax": "$code-trace [--mode=<mode>] <query>",
        "input_kind": "mixed",
        "invocation_class": "implicit-eligible",
        "effect_authority": "read-only",
        "inputs": [
          {
            "id": "query",
            "syntax": "<query>",
            "value_kind": "string",
            "required": true,
            "summary": "Describe the symbol, failure, or history to trace",
            "applies_to": [
              "diagnose",
              "explore",
              "history",
              "select-tool"
            ]
          }
        ],
        "actions": [
          {
            "id": "explore",
            "summary": "Trace an unfamiliar symbol, file, module, or flow",
            "syntax": "$code-trace --mode=explore <query>",
            "input_kind": "free-text",
            "effect_authority": "read-only"
          },
          {
            "id": "diagnose",
            "summary": "Confirm the cause of a failure or regression",
            "syntax": "$code-trace --mode=diagnose <query>",
            "input_kind": "free-text",
            "effect_authority": "read-only"
          },
          {
            "id": "history",
            "summary": "Investigate when and why behavior changed",
            "syntax": "$code-trace --mode=history <query>",
            "input_kind": "free-text",
            "effect_authority": "read-only"
          },
          {
            "id": "select-tool",
            "summary": "Select one code-navigation tool and fallback",
            "syntax": "$code-trace --mode=select-tool <query>",
            "input_kind": "free-text",
            "effect_authority": "read-only"
          }
        ],
        "options": [
          {
            "id": "mode",
            "syntax": "--mode=<mode>",
            "value_kind": "enum",
            "required": false,
            "summary": "Choose the code-trace mode",
            "enum_values": [
              "explore",
              "diagnose",
              "history",
              "select-tool"
            ]
          },
          {
            "id": "dual",
            "syntax": "--dual",
            "value_kind": "boolean",
            "required": false,
            "summary": "Request an independent read-only perspective",
            "default": false,
            "applies_to": [
              "explore"
            ]
          },
          {
            "id": "explain",
            "syntax": "--explain",
            "value_kind": "boolean",
            "required": false,
            "summary": "Request a bounded explanation of the trace",
            "default": false,
            "applies_to": [
              "explore"
            ]
          },
          {
            "id": "depth",
            "syntax": "--depth=<brief|normal|deep>",
            "value_kind": "enum",
            "required": false,
            "summary": "Set the requested explanation depth",
            "enum_values": [
              "brief",
              "normal",
              "deep"
            ],
            "applies_to": [
              "explore"
            ]
          }
        ],
        "examples": [
          {
            "prompt": "$code-trace --mode=explore OrderService",
            "summary": "Trace callers and callees for an unfamiliar symbol"
          }
        ]
      },
      "usageFingerprint": "48654b9393cc852db2f54b7801cc7b40eee7b13eeab8b85ee8244d8248a9d438"
    },
