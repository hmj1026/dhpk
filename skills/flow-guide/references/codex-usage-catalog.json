            "value_kind": "string",
            "required": true,
            "summary": "Select the confirmed specification or change",
            "applies_to": [
              "apply"
            ]
          }
        ],
        "actions": [
          {
            "id": "apply",
            "summary": "Implement the confirmed specification or OpenSpec change",
            "syntax": "$flow-drive <confirmed-spec-or-change-id>",
            "input_kind": "identifier",
            "effect_authority": "workspace-write"
          }
        ],
        "options": [
          {
            "id": "plan",
            "syntax": "--plan[=<model>:<effort>]",
            "value_kind": "string",
            "required": false,
            "summary": "Request a planning pass before implementation",
            "applies_to": [
              "apply"
            ]
          },
          {
            "id": "worker",
            "syntax": "--worker=<worker>",
            "value_kind": "enum",
            "required": false,
            "summary": "Select an explicitly requested implementation worker",
            "enum_values": [
              "claude",
              "codex",
              "agy",
              "auto"
            ],
            "applies_to": [
              "apply"
            ]
          },
          {
            "id": "worker-target",
            "syntax": "--worker-target=<provider>/<model>[:<effort>]",
            "value_kind": "string",
            "required": false,
            "summary": "Select an explicit provider, model, and effort target",
            "applies_to": [
              "apply"
            ]
          },
          {
            "id": "cross-provider",
            "syntax": "--cross-provider",
            "value_kind": "boolean",
