{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["$CLAUDE_PROJECT_DIR/.claude/dhpk/scripts/hooks/pre-edit-guard.sh"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["$CLAUDE_PROJECT_DIR/.claude/dhpk/scripts/hooks/pre-bash-dispatch.sh"]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["$CLAUDE_PROJECT_DIR/.claude/dhpk/scripts/hooks/session-start.sh"],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["$CLAUDE_PROJECT_DIR/.claude/dhpk/scripts/hooks/subagent-stop-verify.sh"]
          }
        ]
      }
    ]
  }
}
