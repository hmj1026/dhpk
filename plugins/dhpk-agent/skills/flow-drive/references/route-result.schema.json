{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dhpk.route-result.v2",
  "title": "dhpk.route-result.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host",
    "cleanedQuery",
    "options",
    "target",
    "availability",
    "backendSelection",
    "diagnostics",
    "disposition"
  ],
  "properties": {
    "schema": {
      "const": "dhpk.route-result.v2"
    },
    "host": {
      "type": "string",
      "enum": ["claude", "cursor", "codex"]
    },
    "cleanedQuery": {
      "type": "string"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeOnly",
        "codexPeer",
        "architect",
        "openSpec",
        "executeExplicit",
        "plan",
        "worker",
        "reasoner"
      ],
      "properties": {
        "routeOnly": { "type": "boolean" },
        "codexPeer": { "type": "boolean" },
        "architect": { "type": "boolean" },
        "openSpec": { "type": "boolean" },
        "executeExplicit": { "type": "boolean" },
        "plan": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "model", "effort"],
              "properties": {
                "enabled": { "const": true },
                "model": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
                  ]
                },
                "effort": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
                  ]
                }
              }
            }
          ]
        },
        "worker": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["requested", "value", "valid"],
              "properties": {
                "requested": { "type": "string" },
                "value": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "enum": ["claude", "codex", "agy"] }
                  ]
                },
                "valid": { "type": "boolean" }
              }
            }
          ]
        },
        "reasoner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "backend", "model", "effort", "valid"],
              "properties": {
                "enabled": { "type": "boolean" },
                "backend": { "type": "string" },
                "model": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
                  ]
                },
                "effort": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
                  ]
                },
                "valid": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "target": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string", "enum": ["skill", "command", "agent"] },
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "portable_skill_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode", "evidence"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["not-checked", "available", "unavailable"]
        },
        "reasonCode": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": [
                "NOT_PUBLISHED",
                "NOT_DISCOVERED",
                "POLICY_RESTRICTED",
                "HOST_UNSUPPORTED",
                "DEPENDENCY_UNAVAILABLE"
              ]
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "surface", "subject", "state", "detail"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "publication",
                  "discovery",
                  "executable",
                  "policy",
                  "fallback"
                ]
              },
              "surface": { "type": "string" },
              "subject": { "type": "string" },
              "state": {
                "type": "string",
                "enum": ["present", "missing", "allowed", "denied"]
              },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "backendSelection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "selected", "fallbackUsed", "reasonCode"],
          "properties": {
            "requested": {
              "type": "string",
              "enum": ["claude", "codex", "agy", "auto"]
            },
            "selected": {
              "type": "string",
              "enum": ["claude", "codex", "agy"]
            },
            "fallbackUsed": { "type": "boolean" },
            "reasonCode": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "enum": ["MISSING_EXECUTABLE"] }
              ]
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": { "type": "string" }
        }
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "route-only",
        "explicit-required",
        "ready",
        "blocked",
        "unavailable"
      ]
    }
  }
}
