  "usageSchema": "dhpk.skill-usage.v1",
  "usage": {
    "code-trace": {
      "display_name": "Code Trace",
      "summary": "Trace code paths, causes, history, or navigation tools",
      "syntax": "$code-trace [--mode=<mode>] <query>",
      "input_kind": "mixed",
      "invocation_class": "implicit-eligible",
      "effect_authority": "read-only",
      "actions": [
        {
          "id": "explore",
          "summary": "Trace an unfamiliar symbol, file, module, or flow",
          "syntax": "$code-trace --mode=explore <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "diagnose",
          "summary": "Confirm the cause of a failure or regression",
          "syntax": "$code-trace --mode=diagnose <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "history",
          "summary": "Investigate when and why behavior changed",
          "syntax": "$code-trace --mode=history <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "select-tool",
          "summary": "Select one code-navigation tool and fallback",
          "syntax": "$code-trace --mode=select-tool <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        }
      ],
      "options": [
        {
          "id": "mode",
          "syntax": "--mode=<mode>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "explore",
            "diagnose",
            "history",
            "select-tool"
          ],
          "summary": "Choose the code-trace mode"
        },
        {
          "id": "dual",
          "syntax": "--dual",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request an independent read-only perspective",
          "applies_to": [
            "explore"
          ]
        },
        {
          "id": "explain",
          "syntax": "--explain",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request a bounded explanation of the trace",
          "applies_to": [
            "explore"
          ]
        },
        {
          "id": "depth",
          "syntax": "--depth=<brief|normal|deep>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "brief",
            "normal",
            "deep"
          ],
          "summary": "Set the requested explanation depth",
          "applies_to": [
            "explore"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$code-trace --mode=explore OrderService",
          "summary": "Trace callers and callees for an unfamiliar symbol"
        }
      ]
    },
    "git-smart-commit": {
      "display_name": "Git Smart Commit",
      "summary": "Group related changes into reviewable commits safely",
      "syntax": "$dhpk-git-smart-commit",
      "input_kind": "none",
      "invocation_class": "explicit-only",
      "effect_authority": "git-write",
      "actions": [
        {
          "id": "group",
          "summary": "Analyze changes and produce grouped commit steps",
          "syntax": "$dhpk-git-smart-commit",
          "input_kind": "none",
          "effect_authority": "git-write"
        }
      ],
      "options": [],
      "examples": [
        {
          "prompt": "$dhpk-git-smart-commit split these changes into logical commits",
          "summary": "Prepare a safe grouped commit plan"
        }
      ]
    },
    "opsx-load-context": {
      "display_name": "Opsx Load Context",
      "summary": "Load resume context through the deterministic fallback chain",
      "syntax": "$dhpk-opsx-load-context",
      "input_kind": "none",
      "invocation_class": "implicit-eligible",
      "effect_authority": "read-only",
      "actions": [
        {
          "id": "load",
          "summary": "Resolve the best available resume context",
          "syntax": "$dhpk-opsx-load-context",
          "input_kind": "none",
          "effect_authority": "read-only"
        }
      ],
      "options": [],
      "examples": [
        {
          "prompt": "$dhpk-opsx-load-context",
          "summary": "Load context for an opsx-apply-resume session"
        }
      ]
    },
    "opsx-post-obs": {
      "display_name": "Opsx Post Obs",
      "summary": "Post one resume observation through the observer boundary",
      "syntax": "$dhpk-opsx-post-observation <observation-context>",
      "input_kind": "free-text",
      "invocation_class": "implicit-eligible",
      "effect_authority": "delegate",
      "actions": [
        {
          "id": "post",
          "summary": "Submit the compact session observation",
          "syntax": "$dhpk-opsx-post-observation <observation-context>",
          "input_kind": "free-text",
          "effect_authority": "delegate"
        }
      ],
      "options": [],
      "examples": [
        {
          "prompt": "$dhpk-opsx-post-observation save-phase summary",
          "summary": "Post the observation during opsx save phase"
        }
      ]
    },
    "tdd": {
      "display_name": "TDD",
      "summary": "Drive behavior-first tests through a minimal red-green loop",
      "syntax": "$dhpk-tdd-workflow [test-generation] <task>",
      "input_kind": "mixed",
      "invocation_class": "implicit-eligible",
      "effect_authority": "workspace-write",
      "actions": [
        {
          "id": "tdd",
          "summary": "Guide a behavior-first test and implementation loop",
          "syntax": "$dhpk-tdd-workflow <task>",
          "input_kind": "free-text",
          "effect_authority": "workspace-write"
        },
        {
          "id": "test-generation",
          "summary": "Generate a focused failing-test scaffold",
          "syntax": "$dhpk-tdd-workflow test-generation <target>",
          "input_kind": "path",
          "effect_authority": "workspace-write"
        }
      ],
      "options": [],
      "examples": [
        {
          "prompt": "$dhpk-tdd-workflow test-generation tests/OrderTest.php",
          "summary": "Start with a behavior-focused test scaffold"
        }
      ]
    },
    "flow-drive": {
      "display_name": "Flow Drive",
      "summary": "Implement a confirmed specification with bounded evidence",
      "syntax": "$flow-drive <confirmed-spec-or-change-id> [--plan[=<model>:<effort>]] [--worker=<worker>] [--reasoner=<provider>/<model>[:<effort>]] [--architect|--no-architect]",
      "input_kind": "mixed",
      "invocation_class": "explicit-only",
      "effect_authority": "workspace-write",
      "actions": [
        {
          "id": "apply",
          "summary": "Implement the confirmed specification or OpenSpec change",
          "syntax": "$flow-drive <confirmed-spec-or-change-id>",
          "input_kind": "identifier",
          "effect_authority": "workspace-write"
        }
      ],
      "options": [
        {
          "id": "plan",
          "syntax": "--plan[=<model>:<effort>]",
          "value_kind": "string",
          "required": false,
          "summary": "Request a planning pass before implementation",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "worker",
          "syntax": "--worker=<worker>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "claude",
            "codex",
            "agy",
            "auto"
          ],
          "summary": "Select an explicitly requested implementation worker",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "reasoner",
          "syntax": "--reasoner=<provider>/<model>[:<effort>]",
          "value_kind": "string",
          "required": false,
          "summary": "Request a bounded second opinion",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "architect",
          "syntax": "--architect",
          "value_kind": "boolean",
          "required": false,
          "summary": "Enable the architecture pass",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "no-architect",
          "syntax": "--no-architect",
          "value_kind": "boolean",
          "required": false,
          "summary": "Disable the architecture pass",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "codex",
          "syntax": "--codex",
          "value_kind": "boolean",
          "required": false,
          "summary": "Request the retired Codex diagnostic",
          "applies_to": [
            "apply"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$flow-drive consolidate-remaining-dhpk-skill-families",
          "summary": "Implement a confirmed OpenSpec change"
        }
      ]
    },
    "flow-guide": {
      "display_name": "Flow Guide",
      "summary": "Guide routes, rules, next steps, closeout, and usage help",
      "syntax": "$flow-guide <help|route|rules|next|close> [--go] [<query>]",
      "input_kind": "action-first",
      "invocation_class": "implicit-eligible",
      "effect_authority": "delegate",
      "actions": [
        {
          "id": "help",
          "summary": "Show available Codex usage or one usage card",
          "syntax": "$flow-guide help [<skill>]",
          "input_kind": "identifier",
          "effect_authority": "read-only"
        },
        {
          "id": "route",
          "summary": "Select the smallest workflow owner for a task",
          "syntax": "$flow-guide route [--go] [<query>]",
          "input_kind": "free-text",
          "effect_authority": "delegate"
        },
        {
          "id": "rules",
          "summary": "Look up the governing workflow rules",
          "syntax": "$flow-guide rules [<query>]",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "next",
          "summary": "Identify the next bounded workflow action",
          "syntax": "$flow-guide next [<query>]",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "close",
          "summary": "Check closeout evidence and remaining gates",
          "syntax": "$flow-guide close [<query>]",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        }
      ],
      "options": [
        {
          "id": "go",
          "syntax": "--go",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request one bounded handoff when the route is eligible",
          "applies_to": [
            "route"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$flow-guide help",
          "summary": "List the available Codex skill usage contracts"
        }
      ]
    },
    "harness-govern": {
      "display_name": "Harness Govern",
      "summary": "Govern harness health, budget, filling, revision, and sync",
      "syntax": "$harness-govern <health|budget|fill|revise|sync> [options]",
      "input_kind": "action-first",
      "invocation_class": "explicit-only",
      "effect_authority": "external-write",
      "actions": [
        {
          "id": "health",
          "summary": "Check harness structure and optionally fix safe issues",
          "syntax": "$harness-govern health [options]",
          "input_kind": "none",
          "effect_authority": "workspace-write"
        },
        {
          "id": "budget",
          "summary": "Measure harness context cost and ranked savings",
          "syntax": "$harness-govern budget [options]",
          "input_kind": "none",
          "effect_authority": "read-only"
        },
        {
          "id": "fill",
          "summary": "Preview or apply missing harness layers",
          "syntax": "$harness-govern fill [options]",
          "input_kind": "none",
          "effect_authority": "workspace-write"
        },
        {
          "id": "revise",
          "summary": "Review and revise an active harness",
          "syntax": "$harness-govern revise [options]",
          "input_kind": "none",
          "effect_authority": "workspace-write"
        },
        {
          "id": "sync",
          "summary": "Plan or apply cross-platform harness synchronization",
          "syntax": "$harness-govern sync [options]",
          "input_kind": "none",
          "effect_authority": "external-write"
        }
      ],
      "options": [
        {
          "id": "dir",
          "syntax": "--dir=<path>",
          "value_kind": "string",
          "required": false,
          "summary": "Select the harness directory"
        },
        {
          "id": "dry-run",
          "syntax": "--dry-run",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Preview changes without writing",
          "applies_to": [
            "health",
            "budget",
            "fill",
            "revise",
            "sync"
          ]
        },
        {
          "id": "fix-safe",
          "syntax": "--fix-safe",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Apply only approved safe health fixes",
          "applies_to": [
            "health"
          ]
        },
        {
          "id": "fix",
          "syntax": "--fix",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Apply the selected health fixes",
          "applies_to": [
            "health"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$harness-govern health --dry-run",
          "summary": "Inspect harness health without changing files"
        }
      ]
    },
    "skill-scope": {
      "display_name": "Skill Scope",
