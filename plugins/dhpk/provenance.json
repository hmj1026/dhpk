    "code-trace": {
      "display_name": "Code Trace",
      "summary": "Trace code paths, causes, history, or navigation tools",
      "syntax": "$code-trace [--mode=<mode>] <query>",
      "input_kind": "mixed",
      "inputs": [
        {
          "id": "query",
          "syntax": "<query>",
          "value_kind": "string",
          "required": true,
          "summary": "Describe the symbol, failure, or history to trace",
          "applies_to": [
            "explore",
            "diagnose",
            "history",
            "select-tool"
          ]
        }
      ],
      "invocation_class": "implicit-eligible",
      "effect_authority": "read-only",
      "actions": [
        {
          "id": "explore",
          "summary": "Trace an unfamiliar symbol, file, module, or flow",
          "syntax": "$code-trace --mode=explore <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "diagnose",
          "summary": "Confirm the cause of a failure or regression",
          "syntax": "$code-trace --mode=diagnose <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "history",
          "summary": "Investigate when and why behavior changed",
          "syntax": "$code-trace --mode=history <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "select-tool",
          "summary": "Select one code-navigation tool and fallback",
          "syntax": "$code-trace --mode=select-tool <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        }
      ],
      "options": [
        {
          "id": "mode",
          "syntax": "--mode=<mode>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "explore",
            "diagnose",
            "history",
            "select-tool"
          ],
          "summary": "Choose the code-trace mode"
        },
        {
          "id": "dual",
          "syntax": "--dual",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request an independent read-only perspective",
          "applies_to": [
            "explore"
          ]
        },
        {
          "id": "explain",
          "syntax": "--explain",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request a bounded explanation of the trace",
          "applies_to": [
            "explore"
          ]
        },
        {
          "id": "depth",
          "syntax": "--depth=<brief|normal|deep>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "brief",
            "normal",
            "deep"
          ],
          "summary": "Set the requested explanation depth",
          "applies_to": [
            "explore"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$code-trace --mode=explore OrderService",
          "summary": "Trace callers and callees for an unfamiliar symbol"
        }
      ]
    },
    "flow-drive": {
      "display_name": "Flow Drive",
      "summary": "Implement a confirmed specification with bounded evidence",
      "syntax": "$flow-drive <confirmed-spec-or-change-id> [--plan[=<model>:<effort>]] [--worker=<worker>] [--worker-target=<provider>/<model>[:<effort>]] [--cross-provider] [--reasoner=<provider>/<model>[:<effort>]] [--architect|--no-architect]",
      "input_kind": "mixed",
      "inputs": [
        {
          "id": "confirmed-spec-or-change-id",
          "syntax": "<confirmed-spec-or-change-id>",
          "value_kind": "string",
          "required": true,
          "summary": "Select the confirmed specification or change",
          "applies_to": [
            "apply"
          ]
        }
      ],
      "invocation_class": "explicit-only",
      "effect_authority": "workspace-write",
      "actions": [
        {
          "id": "apply",
          "summary": "Implement the confirmed specification or OpenSpec change",
          "syntax": "$flow-drive <confirmed-spec-or-change-id>",
          "input_kind": "identifier",
          "effect_authority": "workspace-write"
        }
      ],
      "options": [
        {
          "id": "plan",
          "syntax": "--plan[=<model>:<effort>]",
          "value_kind": "string",
          "required": false,
          "summary": "Request a planning pass before implementation",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "worker",
          "syntax": "--worker=<worker>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "claude",
            "codex",
            "agy",
            "auto"
          ],
          "summary": "Select an explicitly requested implementation worker",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "worker-target",
          "syntax": "--worker-target=<provider>/<model>[:<effort>]",
          "value_kind": "string",
          "required": false,
          "summary": "Select an explicit provider, model, and effort target",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "cross-provider",
          "syntax": "--cross-provider",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Allow the explicitly selected provider boundary",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "reasoner",
          "syntax": "--reasoner=<provider>/<model>[:<effort>]",
          "value_kind": "string",
          "required": false,
          "summary": "Request a bounded second opinion",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "architect",
          "syntax": "--architect",
          "value_kind": "boolean",
          "required": false,
          "summary": "Enable the architecture pass",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "no-architect",
          "syntax": "--no-architect",
          "value_kind": "boolean",
          "required": false,
          "summary": "Disable the architecture pass",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "codex",
          "syntax": "--codex",
          "value_kind": "boolean",
          "required": false,
          "summary": "Request the retired Codex diagnostic",
          "legacy": {
            "replacement_id": "worker",
            "diagnostic_only": true,
            "reason": "Use an explicit worker, worker-target, or reasoner instead of the retired Codex shortcut"
          },
          "applies_to": [
            "apply"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$flow-drive consolidate-remaining-dhpk-skill-families",
          "summary": "Implement a confirmed OpenSpec change"
        }
      ]
    },
