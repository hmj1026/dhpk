  "usage": {
    "php-pro": {
      "display_name": "Php Pro",
      "summary": "Detect PHP runtime and select safe framework guidance",
      "syntax": "$dhpk-php-runtime-router <php-task>",
      "input_kind": "free-text",
      "invocation_class": "implicit-eligible",
      "effect_authority": "read-only",
      "actions": [
        {
          "id": "route",
          "summary": "Detect the runtime and select matching references",
          "syntax": "$dhpk-php-runtime-router <php-task>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        }
      ],
      "options": [],
      "examples": [
        {
          "prompt": "$dhpk-php-runtime-router review this Yii 1.1 controller",
          "summary": "Select PHP-compatible guidance for a backend task"
        }
      ]
    },
    "legacy-code-characterization": {
      "display_name": "Legacy Code Characterization",
      "summary": "Lock observed legacy behavior before refactoring safely",
      "syntax": "$dhpk-legacy-characterization-tests <legacy-target>",
      "input_kind": "path",
      "invocation_class": "implicit-eligible",
      "effect_authority": "workspace-write",
      "actions": [
        {
          "id": "characterize",
          "summary": "Write tests that capture the current legacy behavior",
          "syntax": "$dhpk-legacy-characterization-tests <legacy-target>",
          "input_kind": "path",
          "effect_authority": "workspace-write"
        }
      ],
      "options": [],
      "examples": [
        {
          "prompt": "$dhpk-legacy-characterization-tests protected/models/Order.php",
          "summary": "Lock an untested legacy model before refactoring"
        }
      ]
    },
    "php56-yii-dev": {
      "display_name": "php56-yii-dev",
      "summary": "Implement Yii 1.x backend changes with PHP 5.6-safe tests",
      "syntax": "$dhpk-yii1-php56-development <backend-task>",
      "input_kind": "free-text",
      "invocation_class": "implicit-eligible",
      "effect_authority": "workspace-write",
      "actions": [
        {
          "id": "implement",
          "summary": "Design, test, and implement a Yii 1.x backend change",
          "syntax": "$dhpk-yii1-php56-development <backend-task>",
          "input_kind": "free-text",
          "effect_authority": "workspace-write"
        }
      ],
      "options": [],
      "examples": [
        {
          "prompt": "$dhpk-yii1-php56-development fix this Yii 1.1 controller",
          "summary": "Apply PHP 5.6-safe backend implementation guidance"
        }
      ]
    },
    "yii1-security-audit": {
      "display_name": "Yii1 Security Audit",
      "summary": "Audit Yii 1.1 security boundaries with evidence and fixes",
      "syntax": "$dhpk-yii1-security-audit <source-path> [--output-path=<path>]",
      "input_kind": "path",
      "invocation_class": "implicit-eligible",
      "effect_authority": "read-only",
      "actions": [
        {
          "id": "audit",
          "summary": "Inspect Yii 1.1 framework security boundaries",
          "syntax": "$dhpk-yii1-security-audit <source-path> [--output-path=<path>]",
          "input_kind": "path",
          "effect_authority": "read-only"
        }
      ],
      "options": [
        {
          "id": "output-path",
          "syntax": "--output-path=<path>",
          "value_kind": "string",
          "required": false,
          "summary": "Choose the audit report output directory",
          "applies_to": [
            "audit"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$dhpk-yii1-security-audit protected",
          "summary": "Audit a Yii 1.1 project for framework security issues"
        }
      ]
    },
    "flow-guide": {
      "display_name": "Flow Guide",
      "summary": "Guide routes, rules, next steps, closeout, and usage help",
      "syntax": "$flow-guide <help|route|rules|next|close> [--go] [<query>]",
      "input_kind": "action-first",
      "invocation_class": "implicit-eligible",
      "effect_authority": "delegate",
      "actions": [
        {
          "id": "help",
          "summary": "Show available Codex usage or one usage card",
          "syntax": "$flow-guide help [<skill>]",
          "input_kind": "identifier",
          "effect_authority": "read-only"
        },
        {
          "id": "route",
          "summary": "Select the smallest workflow owner for a task",
          "syntax": "$flow-guide route [--go] [<query>]",
          "input_kind": "free-text",
          "effect_authority": "delegate"
        },
        {
          "id": "rules",
          "summary": "Look up the governing workflow rules",
          "syntax": "$flow-guide rules [<query>]",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "next",
          "summary": "Identify the next bounded workflow action",
          "syntax": "$flow-guide next [<query>]",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "close",
          "summary": "Check closeout evidence and remaining gates",
          "syntax": "$flow-guide close [<query>]",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        }
      ],
      "options": [
        {
          "id": "go",
          "syntax": "--go",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request one bounded handoff when the route is eligible",
          "applies_to": [
            "route"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$flow-guide help",
          "summary": "List the available Codex skill usage contracts"
        }
      ]
    },
    "code-trace": {
      "display_name": "Code Trace",
      "summary": "Trace code paths, causes, history, or navigation tools",
      "syntax": "$code-trace [--mode=<mode>] <query>",
      "input_kind": "mixed",
      "invocation_class": "implicit-eligible",
      "effect_authority": "read-only",
      "actions": [
        {
          "id": "explore",
          "summary": "Trace an unfamiliar symbol, file, module, or flow",
          "syntax": "$code-trace --mode=explore <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "diagnose",
          "summary": "Confirm the cause of a failure or regression",
          "syntax": "$code-trace --mode=diagnose <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "history",
          "summary": "Investigate when and why behavior changed",
          "syntax": "$code-trace --mode=history <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        },
        {
          "id": "select-tool",
          "summary": "Select one code-navigation tool and fallback",
          "syntax": "$code-trace --mode=select-tool <query>",
          "input_kind": "free-text",
          "effect_authority": "read-only"
        }
      ],
      "options": [
        {
          "id": "mode",
          "syntax": "--mode=<mode>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "explore",
            "diagnose",
            "history",
            "select-tool"
          ],
          "summary": "Choose the code-trace mode"
        },
        {
          "id": "dual",
          "syntax": "--dual",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request an independent read-only perspective",
          "applies_to": [
            "explore"
          ]
        },
        {
          "id": "explain",
          "syntax": "--explain",
          "value_kind": "boolean",
          "required": false,
          "default": false,
          "summary": "Request a bounded explanation of the trace",
          "applies_to": [
            "explore"
          ]
        },
        {
          "id": "depth",
          "syntax": "--depth=<brief|normal|deep>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "brief",
            "normal",
            "deep"
          ],
          "summary": "Set the requested explanation depth",
          "applies_to": [
            "explore"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$code-trace --mode=explore OrderService",
          "summary": "Trace callers and callees for an unfamiliar symbol"
        }
      ]
    },
    "flow-drive": {
      "display_name": "Flow Drive",
      "summary": "Implement a confirmed specification with bounded evidence",
      "syntax": "$flow-drive <confirmed-spec-or-change-id> [--plan[=<model>:<effort>]] [--worker=<worker>] [--reasoner=<backend>:<model>:<effort>] [--architect|--no-architect]",
      "input_kind": "mixed",
      "invocation_class": "explicit-only",
      "effect_authority": "workspace-write",
      "actions": [
        {
          "id": "apply",
          "summary": "Implement the confirmed specification or OpenSpec change",
          "syntax": "$flow-drive <confirmed-spec-or-change-id>",
          "input_kind": "identifier",
          "effect_authority": "workspace-write"
        }
      ],
      "options": [
        {
          "id": "plan",
          "syntax": "--plan[=<model>:<effort>]",
          "value_kind": "string",
          "required": false,
          "summary": "Request a planning pass before implementation",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "worker",
          "syntax": "--worker=<worker>",
          "value_kind": "enum",
          "required": false,
          "enum_values": [
            "claude",
            "codex",
            "agy",
            "auto"
          ],
          "summary": "Select an explicitly requested implementation worker",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "reasoner",
          "syntax": "--reasoner=<backend>:<model>:<effort>",
          "value_kind": "string",
          "required": false,
          "summary": "Request a bounded second opinion",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "architect",
          "syntax": "--architect",
          "value_kind": "boolean",
          "required": false,
          "summary": "Enable the architecture pass",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "no-architect",
          "syntax": "--no-architect",
          "value_kind": "boolean",
          "required": false,
          "summary": "Disable the architecture pass",
          "applies_to": [
            "apply"
          ]
        },
        {
          "id": "codex",
          "syntax": "--codex",
          "value_kind": "boolean",
          "required": false,
          "summary": "Request the retired Codex diagnostic",
          "applies_to": [
            "apply"
          ]
        }
      ],
      "examples": [
        {
          "prompt": "$flow-drive consolidate-remaining-dhpk-skill-families",
          "summary": "Implement a confirmed OpenSpec change"
        }
      ]
    },
