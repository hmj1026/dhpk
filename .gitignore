# dhpk runtime, receipts & transient transaction stages
.dhpk/
.dhpk-projection-*
.agents-skills-*
.dhpk-agents-skills-*

# Host runtime artifacts (Claude Code)
.claude/artifacts/
.claude/worktrees/
