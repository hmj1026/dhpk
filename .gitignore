# Platform sync & projections (runtime installations)
# Shipped source templates live in codex/, cursor/, plugins/ without the dot
.codex/
.cursor/

# External agent skill installations & local runtime
# Keep the repo-scoped marketplace descriptor under .agents/plugins/ tracked.
.agents/skills/
.agents/.dhpk-*
.agent/
.antigravity/
.antigravitycli/
.agy/
.playwright-cli/
.gitnexus/

# OpenSpec workflow state is local-only; accepted main specs are the sole
# versioned OpenSpec surface. Keep changes/config/cache available in the
# working tree for local review without adding them to the Git index.
openspec/*
openspec/.*
!openspec/specs/
!openspec/specs/**
openspec/specs/.*/
openspec/specs/**/.*/

# Test coverage & runner reports
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# External tooling cache
.hyperweave/
.superpowers/

# Language & runtime caches
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
.ruff_cache/
.mypy_cache/
*.log

# Secret hygiene (.env files)
.env
.env.*
!.env.example

# Local knowledge drafts, notes & planning scratch
docs/knowledge/
.scratch/
IMPLEMENTATION_PLAN.md

