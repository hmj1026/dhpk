# Plugin build / runtime artifacts
.claude/artifacts/
.claude/worktrees/
.claude/cache/

# Python bytecode (hook helper scripts under scripts/hooks/_lib/*.py)
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
*~
*.code-workspace
.idea/
.vscode/

# Node (if any helper scripts grow node deps)
node_modules/

# Logs
*.log

# Generated by install-codex-skills.sh (shipped source lives in codex/ without the dot)
.codex/

# Generated by install-cursor-harness.sh (shipped source lives in cursor/ without the dot)
.cursor/

# External agent skill installations (including the OpenSpec CLI package).
# Keep the repo-scoped marketplace descriptor under .agents/plugins/ tracked.
.agents/skills/

# Hyperweave tooling cache
.hyperweave/

# Superpowers execution state and reports (local-only)
.superpowers/

# Local Claude Code overrides
.claude/settings.local.json

# Session retrospective log (local-only, not part of the dhpk plugin source)
.claude/dhpk_advice.md
CONTEXT.md


# Plans
.claude/plans/
.claude/workflows/

# OpenSpec workflow state is local-only; accepted main specs are the sole
# versioned OpenSpec surface. Keep changes/config/cache available in the
# working tree for local review without adding them to the Git index.
openspec/*
openspec/.*
!openspec/specs/
!openspec/specs/**
openspec/specs/.*/
openspec/specs/**/.*/
.claude/commands/opsx/
.claude/skills/gitnexus/*/
.claude/skills/openspec-*/
.antigravitycli/
.playwright-cli/

.gitnexus
